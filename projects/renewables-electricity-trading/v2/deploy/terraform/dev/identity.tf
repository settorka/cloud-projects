# Lightsail has no EC2 instance profile. Keys are installed out-of-band and never
# generated by Terraform, which would put secret material in state.
resource "aws_iam_user" "runtime" { name = "${var.name}-runtime" }
resource "aws_iam_user_policy" "runtime" {
  name = "runtime"
  user = aws_iam_user.runtime.name
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    { Effect = "Allow", Action = ["events:PutEvents"], Resource = aws_cloudwatch_event_bus.domain.arn },
    { Effect = "Allow", Action = ["sqs:GetQueueUrl", "sqs:GetQueueAttributes", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:SendMessage"], Resource = concat([for q in aws_sqs_queue.input : q.arn], [for q in aws_sqs_queue.dlq : q.arn]) },
    { Effect = "Allow", Action = ["s3:PutObject"], Resource = "${aws_s3_bucket.backup.arn}/postgres/*" },
    { Effect = "Allow", Action = ["ecr:GetAuthorizationToken"], Resource = "*" },
    { Effect = "Allow", Action = ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"], Resource = [for r in aws_ecr_repository.service : r.arn] },
    { Effect = "Allow", Action = ["xray:PutTraceSegments", "xray:PutTelemetryRecords"], Resource = "*" },
    { Effect = "Allow", Action = ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"], Resource = "${aws_cloudwatch_log_group.application.arn}:*" },
    { Effect = "Allow", Action = ["cloudwatch:PutMetricData"], Resource = "*", Condition = { StringEquals = { "cloudwatch:namespace" = "Renewables/V2" } } }
  ] })
}
