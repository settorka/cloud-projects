# V2 configuration. Keep the real v2.env private; choose one template per environment.

# Django services — identity, authentication and API limits.
DJANGO_SECRET_KEY=local-only-not-for-deployment-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,trading,market-data,valuation,testserver
TRADER_TOKEN=1111111111111111111111111111111111111111
RISK_TOKEN=2222222222222222222222222222222222222222
VIEWER_TOKEN=3333333333333333333333333333333333333333
API_PAGE_SIZE=100
HTTP_MAX_BODY_BYTES=65536
APP_VERSION=v2-dev
DEPLOYMENT_ENVIRONMENT=local
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=30

# PostgreSQL — connection, service ownership and query limits.
DB_HOST=postgres
DB_NAME=renewables
DB_PORT=5432
POSTGRES_PASSWORD=local-admin-only
TRADING_DB_USER=trading
TRADING_DB_SCHEMA=trading
TRADING_DB_PASSWORD=local-trading-only
MARKET_DATA_DB_USER=market_data
MARKET_DATA_DB_SCHEMA=market_data
MARKET_DATA_DB_PASSWORD=local-market-data-only
VALUATION_DB_USER=valuation
VALUATION_DB_SCHEMA=valuation
VALUATION_DB_PASSWORD=local-valuation-only
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=10000
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=128MB

# AWS — region, image registry, domain and credential paths.
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_SHARED_CREDENTIALS_FILE=/run/aws/credentials
CONTAINER_AWS_CREDENTIALS_FILE=/run/aws/credentials
AWS_CREDENTIALS_DIR=/opt/renewables/credentials
ECR_REGISTRY=REPLACE_ACCOUNT.dkr.ecr.eu-west-2.amazonaws.com/renewables-v2-dev
IMAGE_TAG=REPLACE_GIT_COMMIT_SHA
DOMAIN_NAME=trading-dev.example.com
BACKUP_BUCKET=REPLACE_BUCKET
CLOUDWATCH_LOG_GROUP=/renewables/renewables-v2-dev
SDK_CONNECT_TIMEOUT_SECONDS=3
AWS_DEPLOY_PROFILE=dev
AWS_ACCOUNT_ID=REPLACE_ACCOUNT
ACCESS_MODE=tunnel
TLS_MODE=internal
TLS_CA_FILE=
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80

# Messaging — transport, queues and delivery timeouts.
EVENT_TRANSPORT=sqs
EVENT_BUS_NAME=renewables-v2-dev
QUEUE_PREFIX=
TRADING_QUEUE=trading-input
VALUATION_QUEUE=valuation-input
SQS_ENDPOINT_URL=http://elasticmq:9324
SQS_READ_TIMEOUT_SECONDS=25
SQS_WAIT_SECONDS=2
SQS_VISIBILITY_SECONDS=30
SQS_SDK_ATTEMPTS=1
EVENTBRIDGE_READ_TIMEOUT_SECONDS=5
EVENTBRIDGE_SDK_RETRIES=2
EVENTBRIDGE_ROUTING_MAX_AGE=3600

# Workers — concurrency, batching and retry intervals.
WORKER_CONCURRENCY=2
OUTBOX_BATCH_SIZE=20
WORKER_RETRY_SECONDS=2
OUTBOX_IDLE_SECONDS=1

# Elexon — endpoint, ingestion schedule and HTTP limits.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
IMPORT_INTERVAL_SECONDS=300
ELEXON_REQUEST_TIMEOUT_SECONDS=20
ELEXON_CONNECT_TIMEOUT_SECONDS=5
ELEXON_FETCH_CONCURRENCY=2

# OpenTelemetry — sampling, export and bounded buffers.
OTEL_ENABLED=false
OTEL_TRACES_SAMPLER_ARG=0.01
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_MAX_QUEUE_SIZE=512
OTEL_MAX_EXPORT_BATCH_SIZE=64
OTEL_EXPORT_DELAY_MS=5000
OTEL_EXPORT_TIMEOUT_SECONDS=2
OTEL_DIAGNOSTIC_ENABLED=true
OTEL_DIAGNOSTIC_SAMPLE_RATIO=1.0
COLLECTOR_LIMIT_MIB=96
COLLECTOR_SPIKE_MIB=24
COLLECTOR_BATCH_SIZE=32
COLLECTOR_BATCH_MAX_SIZE=128
COLLECTOR_BATCH_TIMEOUT=1s
COLLECTOR_XRAY_WORKERS=2
COLLECTOR_XRAY_TIMEOUT_SECONDS=2
COLLECTOR_XRAY_RETRIES=1

# Docker Compose — images, resource limits and local ports.
COMPOSE_PROJECT_NAME=renewables-electricity-trading-v2
POSTGRES_IMAGE=postgres:17.7-bookworm
ELASTICMQ_IMAGE=softwaremill/elasticmq-native:1.6.12
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.139.0
CADDY_IMAGE=caddy:2.10.2-alpine
BIND_ADDRESS=127.0.0.1
TRADING_PORT=8101
MARKET_DATA_PORT=8102
VALUATION_PORT=8103
PROCESS_MEMORY=384m
PROCESS_CPUS=0.5
POSTGRES_MEMORY=768m
POSTGRES_CPUS=1
ELASTICMQ_MEMORY=256m
ELASTICMQ_CPUS=0.5
COLLECTOR_MEMORY=160m
COLLECTOR_CPUS=0.15
CADDY_MEMORY=96m
CADDY_CPUS=0.1
STOP_GRACE_PERIOD=40s
DOCKER_LOG_MAX_SIZE=5m
DOCKER_LOG_MAX_FILES=2
POSTGRES_HEALTH_INTERVAL=3s
POSTGRES_HEALTH_TIMEOUT=3s
POSTGRES_HEALTH_RETRIES=20
API_HEALTH_INTERVAL=10s
API_HEALTH_TIMEOUT=5s
API_HEALTH_RETRIES=6

# Local tools — URLs and bounded simulator defaults.
TRADING_URL=http://127.0.0.1:8101
VALUATION_URL=http://127.0.0.1:8103
SIMULATOR_URL=http://trading:8000
SIMULATOR_REQUESTS=100
SIMULATOR_RATE=10
SIMULATOR_CONCURRENCY=20
SIMULATOR_SEED=1
SIMULATOR_PORTFOLIO=demo

# Host operations — deployment paths, backup and health schedules.
DEPLOY_ROOT=/opt/renewables
BACKUP_MAX_BYTES=1073741824
DEPLOY_WAIT_SECONDS=180
BACKUP_SCHEDULE=daily
HEALTH_SCHEDULE=*:0/5

# Terraform — infrastructure identity, access and operating profile.
TF_VAR_region=eu-west-2
TF_VAR_name=renewables-v2-dev
TF_VAR_bundle_id=medium_3_0
TF_VAR_ssh_public_key=REPLACE_PUBLIC_SSH_KEY
TF_VAR_operator_cidr=203.0.113.10/32
TF_VAR_client_cidr=203.0.113.10/32
TF_VAR_alert_email=operator@example.com
TF_VAR_domain_name=trading-dev.example.com
TF_VAR_backup_bucket_name=REPLACE_BUCKET
TF_VAR_state_bucket_name=REPLACE_STATE_BUCKET
TF_STATE_KEY=renewables/v2/dev.tfstate
TF_VAR_operating='{"log_retention_days":7,"queue_visibility_seconds":60,"queue_wait_seconds":20,"queue_retention_seconds":345600,"dlq_retention_seconds":1209600,"max_receive_count":5,"event_max_age_seconds":3600,"event_retry_attempts":10,"backup_retention_days":7,"ecr_retained_images":3,"queue_age_alarm_seconds":120,"disk_alarm_percent":70,"backup_alarm_hours":26}'
TF_VAR_aws_account_id=REPLACE_ACCOUNT

TF_VAR_access_mode=tunnel