{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "type",
    "entity_id",
    "revision",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "type": {
      "enum": [
        "trade.changed",
        "forecast.updated",
        "price.updated",
        "meter.updated"
      ]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "trace_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceparent": {
          "type": "string",
          "maxLength": 128
        },
        "tracestate": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
