          },
          {
            "name": "Counterparty",
            "dataType": "string",
            "sourceColumn": "Counterparty"
          },
          {
            "name": "Pair",
            "dataType": "string",
            "sourceColumn": "Pair"
          }
        ],
        "partitions": [
          {
            "name": "Payment",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "FxWarehouse",
              "query": "SELECT [BatchId],[PaymentId],[Reference],[Currency],[Direction],[PaymentDate],[Amount],[AllocatedAmount],[UnappliedAmount],[PaymentStatus],[Counterparty],[Pair] FROM analytics.[Payment]"
            }
          }
        ]
      }
    ],
    "relationships": [
