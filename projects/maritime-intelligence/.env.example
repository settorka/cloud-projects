# Copy to .env in this project directory. Do not commit .env.
# Exported shell variables override this file. All durations name their units.

# ── Application and container images ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=maritime-v1
APP_IMAGE=maritime-intelligence:local
POSTGRES_IMAGE=timescale/timescaledb-ha:pg17
KAFKA_IMAGE=apache/kafka:3.9.1
OBJECT_STORE_IMAGE=chrislusf/seaweedfs:4.47
PROXY_IMAGE=caddy:2.10.2
LOG_LEVEL=INFO
MIGRATIONS_DIR=migrations

# ── API: container listener, local host binding, authentication and query bounds
# API_HOST is inside the container; API_BIND controls exposure on the host.
API_HOST=0.0.0.0
API_PORT=8000
API_BIND=127.0.0.1:8200
# Local-only example. Replace with a generated token before sharing access.
API_TOKEN=local-only-replace-with-a-random-token
API_PAGE_SIZE=100
API_MAX_PAGE_SIZE=1000
API_HISTORY_HOURS=24
FRESH_SECONDS=300
EXPIRED_SECONDS=1800

# ── PostgreSQL / TimescaleDB / PostGIS ─────────────────────────────────────────
# Existing volumes retain their original DB credentials. Changing this file alone
# does not rotate an existing PostgreSQL password. URL-encode special characters.
POSTGRES_USER=maritime
POSTGRES_PASSWORD=local-maritime-development
POSTGRES_DB=maritime
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=40
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=3000
POSITION_RETENTION_DAYS=7
POSTGRES_HEALTH_INTERVAL=5s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=20

# ── Kafka: client, topic and consumer ─────────────────────────────────────────
KAFKA_SERVERS=kafka:9092
KAFKA_TOPIC=ais.positions.v1
KAFKA_CONSUMER_GROUP=maritime-positions-v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_QUEUE_MAX_MESSAGES=10000
KAFKA_POLL_SECONDS=1

# ── Kafka: local single-node KRaft broker ──────────────────────────────────────
# Persisted volumes must keep the same cluster ID. Change only for a new cluster.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${KAFKA_SERVERS}
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_LOG_RETENTION_HOURS=48
# Kafka applies this byte cap per partition, not per cluster.
KAFKA_LOG_RETENTION_BYTES=5368709120
KAFKA_LOG_SEGMENT_BYTES=268435456
KAFKA_HEAP_OPTS="-Xmx512m -Xms256m"
KAFKA_HEALTH_INTERVAL=10s
KAFKA_HEALTH_TIMEOUT=10s
KAFKA_HEALTH_RETRIES=20

# ── Object storage: local S3-compatible endpoint / AWS adapter configuration ───
# For AWS: empty endpoint, false path style, and instance-role credentials.
# Never put real AWS credentials into the example file.
S3_BUCKET=maritime-local
S3_ENDPOINT_URL=http://objects:8333
S3_PATH_STYLE=true
S3_MAX_ATTEMPTS=3
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local-access
AWS_SECRET_ACCESS_KEY=local-secret

# ── Live AIS source: TLS MQTT over WebSockets ─────────────────────────────────
# Provider-specific payload decoding stays in the Digitraffic adapter.
AIS_MQTT_HOST=meri.digitraffic.fi
AIS_MQTT_PORT=443
AIS_MQTT_PATH=/mqtt
AIS_MQTT_TOPIC=vessels-v2/+/location
AIS_MQTT_KEEPALIVE_SECONDS=30
AIS_MQTT_RECONNECT_MIN_SECONDS=1
AIS_MQTT_RECONNECT_MAX_SECONDS=60
# west,south,east,north; filtering is local, not an upstream coverage guarantee.
AIS_BBOX=19,59,30,66

# ── Scheduled reference ingestion ─────────────────────────────────────────────
REFERENCE_API_URL=https://meri.digitraffic.fi/api/port-call/v1/port-calls
DIGITRAFFIC_USER=maritime-intelligence/0.1
REFERENCE_INTERVAL_SECONDS=900
REFERENCE_MAX_BYTES=20971520
HTTP_TIMEOUT_SECONDS=20

# ── Port-visit inference: evidence thresholds ──────────────────────────────────
# Changing these changes inference semantics. Review before using operationally.
VISIT_ARRIVAL_OBSERVATIONS=3
VISIT_ARRIVAL_SECONDS=300
VISIT_DEPARTURE_OBSERVATIONS=2
VISIT_DEPARTURE_SECONDS=120
VISIT_GAP_SECONDS=600
VISIT_EXIT_BUFFER_METRES=250

# ── V2 optional public HTTPS ──────────────────────────────────────────────────
# Leave both empty for SSM-only access. Public HTTPS needs a domain you control.
DOMAIN=
COMPOSE_PROFILES=

# ── OpenTelemetry: application → collector; CloudWatch in AWS ─────────────────
# V1 collector prints locally; V2 exports to CloudWatch Logs/Metrics and X-Ray.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=maritime
OTEL_PROJECT_NAME=maritime-intelligence
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORT_TIMEOUT_SECONDS=3
# One percent of root traces; metrics and logs are not sampled by this setting.
OTEL_TRACES_SAMPLER_ARG=0.01
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=64
OTEL_BLRP_MAX_QUEUE_SIZE=512
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=64
OTEL_BACKUP_MARKER_PATH=/run/maritime/backup-success
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.164.0
OTEL_COLLECTOR_MEMORY_LIMIT=256m
OTEL_COLLECTOR_LIMIT_MIB=192
OTEL_COLLECTOR_SPIKE_MIB=32
OTEL_COLLECTOR_BATCH_SIZE=64
OTEL_COLLECTOR_BATCH_TIMEOUT=5s
OTEL_HOST_METRICS_INTERVAL=60s
CLOUDWATCH_LOG_GROUP=/maritime-intelligence/application
CLOUDWATCH_METRICS_LOG_GROUP=/maritime-intelligence/metrics
CLOUDWATCH_METRIC_NAMESPACE=MaritimeIntelligence
