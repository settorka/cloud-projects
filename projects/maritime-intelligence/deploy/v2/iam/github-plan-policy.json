{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLondonComputeCatalogueForInitialTerraformPlan",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-2"
        }
      }
    }
  ]
}
